{
  "name": "hangman",
  "version": "0.0.0",
  "homepage": "https://forca-wheat.vercel.app/",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "prepare": "npx only-allow pnpm && npx husky",
    "migration:generate": "sequelize-cli migration:generate",
    "migration:run": "sequelize-cli db:migrate",
    "migration:undo:all": "sequelize-cli db:migrate:undo:all",
    "migration:undo": "sequelize-cli db:migrate:undo",
    "seed:generate": "sequelize-cli seed:generate",
    "seed:run": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "prebuild": "rm -fr .next ; pnpm run build-storybook",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "start": "next start",
    "predev": "rm -fr .next",
    "dev": "next dev",
    "lint": "next lint",
    "lint:fix": "eslint src --fix --max-warnings=0",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "rm -fr storybook-static public/storybook-static",
    "build-storybook": "storybook build && mv storybook-static public/storybook-static"
  },
  "private": true,
  "dependencies": {
    "@storybook/addon-styling": "^2.0.0",
    "axios": "^1.7.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.1",
    "hash-generator": "^0.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.0.4",
    "next-seo": "^6.6.0",
    "next-sitemap": "^4.2.3",
    "pg": "^8.11.3",
    "react": "^19.3.0",
    "react-icons": "^4.4.0",
    "sequelize": "^6.35.2",
    "sequelize-cli": "^6.6.5",
    "styled-components": "^5.3.5",
    "web-vitals": "^2.1.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ]
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.10.9",
    "@types/react": "18.2.47",
    "@types/styled-components": "^5.1.26",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.9.1",
    "eslint-plugin-storybook": "^10.6.0",
    "husky": "^9.1.6",
    "playwright": "latest",
    "prettier": "3.3.3",
    "storybook": "^10.6.0",
    "typescript": "5.3.3",
    "vite": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=10.20.0"
  },
  "type": "module"
}