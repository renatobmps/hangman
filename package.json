  "scripts": {
    "build": "next build --turbopack",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "db:create": "sequelize-cli db:create",
    "db:migrate:generate": "sequelize-cli migration:generate",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed:generate": "sequelize-cli seed:generate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "prepare": "npx husky",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:playwright": "vitest run --browser --testNamePattern=playwright",
    "test:playwright:coverage": "vitest run --browser --coverage --reporter=html"
  },
  "dependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "hash-generator": "^0.1.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.2.1",
    "next-seo": "^6.8.0",
    "next-sitemap": "^4.2.3",
    "pg": "^8.20.0",
    "react-icons": "^5.6.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "styled-components": "^6.3.12",
    "typescript": "^5.9.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.1",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-onboarding": "^10.3.1",
    "@storybook/addon-styling": "^2.0.0",
    "@storybook/addon-styling-webpack": "^3.0.0",
    "@storybook/addon-vitest": "^10.3.1",
    "@storybook/nextjs-vite": "^10.3.1",
    "@types/bcrypt": "^6.0.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-storybook": "^10.3.1",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "storybook": "^10.3.1",
    "tailwindcss": "^4.2.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=v24.13.1",
    "npm": ">=11.8.0"
  }
