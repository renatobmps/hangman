{
  "name": "design",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project design --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/design/tsconfig.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/design",
        "command": "storybook build -o ../../dist/storybook"
      },
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["storybook", "@storybook/test-runner"]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/storybook",
        "{options.output-dir}",
        "{options.outputDir}",
        "{options.o}"
      ],
      "cache": true
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/design",
        "command": "storybook dev -p 6006 --host 0.0.0.0 --no-open"
      }
    }
  }
}
